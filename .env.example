# ── Database (MySQL) ─────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave empty if your root user has no password
DB_PASS=
DB_NAME=event_ticketing_system

# ── API server ───────────────────────────────────────────────
# 5001 avoids the macOS AirPlay/ControlCenter reservation on 5000
PORT=5001

# ── Security ─────────────────────────────────────────────────
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (the Vite dev server)
CORS_ORIGIN=http://localhost:3000

# ── Seeded admin account (development/testing) ───────────────
# Created on `npm run seed` if the users table is empty or lacks an admin.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eventra.app
ADMIN_PASSWORD=
ADMIN_PASSWORD_CONFIRM=
